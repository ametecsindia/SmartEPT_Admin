  if (!body.name) { $('#pol-err').textContent = 'Policy name is required.'; return; }
  try {
    if (POL_EDIT_ID) await api('/policies/' + type + '/' + POL_EDIT_ID, { method: 'PUT', body: JSON.stringify(body) });

<?xml version="1.0" encoding="UTF-8"?>
<!--
  SmartEPT on-premises - IIS URL rewrite for Laravel pretty URLs
  (SmartPRS2 pattern, 14-Aug-2026). This file lives in the application's
  public\ folder, which must be the IIS site root.
  REQUIRES the IIS "URL Rewrite" module (https://www.iis.net/downloads/microsoft/url-rewrite).
  Harmless everywhere else: Apache/Nginx ignore web.config entirely.
-->
<configuration>
  <system.webServer>
    <!-- ===================================================================
         WebDAV MUST GO (Ejaz's client, 14-Aug-2026 - first IIS install).
         IIS enables WebDAV by default and it CLAIMS the PUT and DELETE verbs
         before URL Rewrite or PHP ever see the request, answering
         405 Method Not Allowed. The symptom is unmistakable: every page loads,
         every "create" works (POST), and then every Edit -> Save and every
         Delete fails with HTTP 405 - Branch, Department, Users, Employees,
         Policies, all of them.
         BOTH lines are required: the module AND its handler.
         =================================================================== -->
    <modules>
      <remove name="WebDAVModule" />
    </modules>
    <handlers>
      <remove name="WebDAV" />
    </handlers>
    <rewrite>
      <rules>
        <!-- Strip a trailing slash (except for real directories), GET/HEAD only.
             A 301 on a PUT/POST makes the browser retry it as GET, which then
             lands on a route that has no GET - another way to produce a 405. -->
        <rule name="SmartEPT Trailing Slash" stopProcessing="true">
          <match url="^(.*)/$" ignoreCase="false" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_METHOD}" pattern="^(GET|HEAD)$" ignoreCase="true" />
          </conditions>
          <action type="Redirect" redirectType="Permanent" url="/{R:1}" />
        </rule>
        <!-- Send everything that is not a real file or directory to index.php
             (index.php also handles the branded /slug/api rewrite). -->
        <rule name="SmartEPT Front Controller" stopProcessing="true">
          <match url="^" ignoreCase="false" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" ignoreCase="false" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" ignoreCase="false" negate="true" />
          </conditions>
          <action type="Rewrite" url="index.php" />
        </rule>
      </rules>
    </rewrite>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.php" />
      </files>
    </defaultDocument>
    <!-- Never serve dotfiles / sensitive paths as static content. -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment=".env" />
          <add segment="license.lic" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>

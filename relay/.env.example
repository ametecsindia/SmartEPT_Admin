# Copy to .env and fill in.
# Must be the EXACT SAME string as smartept's APP_KEY (config/liveview.php
# defaults to it) — including the "base64:" prefix, e.g.:
#   RELAY_SECRET=base64:f1flY5G3rrhJbe/PNYI4WdwmtbU39BHrPH5qjNm+17s=
# This is the shared secret both sides use to sign/verify the short-lived
# stream/view tokens. The relay never talks to Laravel directly; the token
# signature is the only trust it has. Only set LIVEVIEW_RELAY_SECRET in
# smartept/.env (overriding this default) if you want a secret dedicated to
# LiveView instead of reusing APP_KEY.
RELAY_SECRET=change-me-match-smartept-APP_KEY-exactly

# Port this relay process listens on. smartept's LIVEVIEW_RELAY_URL (default
# ws://127.0.0.1:8098) must point at this.
RELAY_PORT=8098

# Optional — set BOTH to enable wss:// (18-Sep-2026). Point these at the SAME
# certificate files this machine's web server already uses for its HTTPS site
# (e.g. an nginx/Apache/Laragon vhost's fullchain.pem + privkey.pem, or a
# Let's Encrypt live/<domain>/ pair). Same domain, so the browser trusts it
# exactly like the main site — nothing extra to buy or configure per client.
# Leave both blank for a plain http:// site / LAN-only install: the relay then
# falls back to ws:// exactly as before.
RELAY_TLS_CERT=
RELAY_TLS_KEY=

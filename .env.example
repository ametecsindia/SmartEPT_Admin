APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Must match the Organisation timezone. A UTC server clock against IST agent timestamps
# silently mis-decides every "has this instant passed?" check (shift end, heartbeat staleness).
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# SmartEPT licensing (ON-PREMISE INSTALLS)
# ---------------------------------------------------------------------------
# SMARTEPT_ONPREM must be true on a client-hosted server. Without it the
# /activate page shows the "managed by Ametecs" notice instead of the licence
# upload form and POST /activate returns 404 — i.e. the client cannot activate
# at all. The Windows/Linux installers set it automatically; set it by hand if
# you are configuring .env yourself.
SMARTEPT_ONPREM=true

# Master enforcement switch. Leave true on every client install. (Ametecs
# developers switch enforcement off locally with `php artisan smartept:licence
# off`, which writes a machine-bound key file — never with this variable.)
SMARTEPT_LICENCE_ENFORCE=true

# App/website enforcement on a NEW install. ENFORCE = armed from the first sign-in, with no
# learning period: the application catalogue, the Store/desktop identifiers, the website
# categories and the BANKING profile all ship with this package, so there is nothing for a
# client to rediscover.
#
# ⚠ READ BEFORE SHIPPING THIS TO A NEW SITE. The learning period had one job this setting
# skips: finding the programs THIS client runs from outside %WINDIR% and %PROGRAMFILES%. The
# first AppLocker deny rule turns the collection deny-by-default, so anything in %LOCALAPPDATA%
# — Teams, VS Code, Slack, or the client's own CRM/ERP — will not launch until it is allowed.
# Ship ENFORCE only where that estate is known.
#
# If a program stops opening: Enforcement -> Disable in the console. Never gated; endpoints
# drop their policy on the next heartbeat (~30s).
#
# OFF | ENFORCE   (blank or unknown = OFF. AUDIT is refused unless the next setting is true.)
SMARTEPT_ENFORCEMENT_DEFAULT=ENFORCE

# Is the LEARNING period part of this installation at all? (27-Aug-2026, Ejaz)
#
# false on every client package. The application catalogue ships with SmartEPT, so there is
# nothing left for a site to discover, and enforcement has exactly two states — on and off.
# The console shows one button; `start-audit`, `promote` and `smartept:enforcement audit` are
# all refused, so nothing can put this site back into learning by accident.
#
# Set true ONLY on our own lab box, when surveying an estate whose applications are genuinely
# unknown. That is the one case where the would-have-blocked report says something the
# catalogue cannot.
SMARTEPT_ENFORCEMENT_LEARNING=false

# Where the node-locked licence file lives. Default: license.lic beside this file.
# SMARTEPT_LICENSE_FILE=
